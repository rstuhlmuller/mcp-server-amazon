{
  "name": "mcp-server-amazon",
  "private": true,
  "description": "Amazon Model Context Protocol Server",
  "version": "1.0.0",
  "main": "./build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && chmod -R 755 ./build",
    "clean": "rm mocks/*_202*",
    "test:lists": "npm run build && node --experimental-test-module-mocks --test tests/lists.test.mjs",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs",
    "test:plugin": "npm run package:plugin && node --test tests/plugin.test.mjs",
    "test:auth": "npm run build && node --experimental-test-module-mocks --test tests/auth.test.mjs tests/session-refresh.test.mjs",
    "login": "node scripts/login.mjs"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0",
    "cheerio": "^1.1.0",
    "puppeteer": "^24.10.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
